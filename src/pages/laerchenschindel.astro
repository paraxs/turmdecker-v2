---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ContentSection from "../components/ContentSection.astro";
import { Image } from "astro:assets";

import imgLs01 from "../assets/laerchenschindel/laerchenschindel04.webp";
import imgLs02 from "../assets/laerchenschindel/laerchenschindel02.webp";
import imgLs03 from "../assets/laerchenschindel/laerchenschindel03.webp";
import imgLs05 from "../assets/laerchenschindel/laerchenschindel05.webp";
import imgSchrunsTurm from "../assets/laerchenschindel/schruns-pfarrkirche-turm.webp";
import imgSchrunsMoos from "../assets/laerchenschindel/schruns-schindeln-moos-flechten.webp";
import imgSchrunsBruch from "../assets/laerchenschindel/schruns-gebrochene-schindeln.webp";
import imgSchrunsReparatur from "../assets/laerchenschindel/schruns-geoeffneter-reparaturbereich.webp";
import imgSchrunsNeu from "../assets/laerchenschindel/schruns-neue-und-alte-schindeln.webp";
const SHINGLE_CALC_URL = "https://tools.turmdecker.com/bedarfsermittlung-holzschindel";
---

<Layout
  title="Lärchenschindel-Dächer & Sanierung | Turmdecker"
  description="Lärchenschindel-Dächer: handgespaltene Schindeln, fachgerechte Verlegung und Sanierung an Kirchtürmen, Dächern, Steildächern und Fassaden."
>
  <Header slot="header" />

  <!-- HERO: exakt gleiches Setup wie bei Eindeckungen -->
  <Hero
    images={[imgLs05]}
    heightClass="h-[55vh]"
    contentClass="pt-24 md:pt-28"
    overlayClass="bg-black/45"
	bgOpacityClass="opacity-85"
    storageKey="tdHero:laerchenschindel"
  >
    <p class="uppercase tracking-[0.2em] text-white/70 text-xs md:text-sm">
      Holzschindel im Alpenraum
    </p>

    <h1 class="text-4xl md:text-6xl font-bold mt-4">
      LÄRCHENSCHINDEL-DÄCHER<span class="text-primary">.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-white/85 text-lg leading-relaxed">
      Handgespaltene Lärchenschindeln, fachgerecht verlegt – auf Kirchtürmen,
      Dächern und Fassaden. Gerüstfrei am Seil, dokumentiert für Planung
      und Denkmalpflege.
    </p>
  </Hero>

  <!-- SECTION 1 -->
  <ContentSection
    title="Aufbau & Lebensdauer"
    image={imgLs01}
    alt="Dach mit Lärchenschindeln"
  >
    <p>
      Lärchenschindeln sind im Alpenraum seit Jahrhunderten bewährt.
      Ihre Nutzungsdauer hängt von Materialqualität, Dachneigung, Exposition,
      Hinterlüftung, Unterkonstruktion und Pflege ab. Eine feste Lebensdauer
      lässt sich daraus nicht garantieren.
    </p>
    <ul class="list-disc pl-5 mt-4 space-y-2">
      <li>Handgespaltene Lärchenschindeln mit stehenden, möglichst eng gewachsenen Jahresringen und der typischen rötlichen Lärchenholzfärbung</li>
      <li>Aus unserer Praxis: etwa 11 mm als Mindestdicke der Schindeln – ein betrieblicher Erfahrungswert, keine allgemeine Normvorgabe</li>
      <li>2- oder 3-fach Deckung je nach Dachneigung und Exposition</li>
      <li>Unterkonstruktion als hinterlüftete Sparschalung bzw. Traglattung</li>
      <li>Ausreichende Hinterlüftung und fachgerechte Eckausbildungen, Mulden und Ortgänge</li>
      <li>Regelmäßiges Entfernen von Laub und Nadeln, damit die Deckung abtrocknen kann</li>
    </ul>
  </ContentSection>

    <!-- SECTION 2 -->
  <ContentSection
    title="Kosten & Wirtschaftlichkeit"
    image={imgLs02}
    alt="Detailansicht Lärchenschindel"
    reverse={true}
  >
    <p>
      Die Kosten pro Quadratmeter hängen von Dachform, Höhenlage und
      gewünschter Ausführung ab. Entscheidend ist, dass Konstruktion und
      Deckung so gewählt werden, dass die Schindeln ihre volle Lebensdauer
      erreichen.
    </p>
    <p class="mt-4">
      Durch gerüstfreie Ausführung am Seil können wir vor allem bei
      Sanierungen bestehender Dächer Gerüst- und Nebenkosten deutlich
      reduzieren.
    </p>

    <!-- Bedarfsrechner CTA (innerhalb von ContentSection) -->
	<div class="not-prose mt-8 rounded-2xl border border-primary/20 bg-primary/5 p-6">
	 <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <p class="text-dark-900 font-bold text-lg">
        Bedarfsrechner für Lärchenschindeln
      </p>
      <p class="mt-1 text-gray-600 text-sm">
        Schnelle Mengen- und Bedarfsermittlung – ideal für Vorplanung & Angebotsphase.
      </p>
    </div>

    <a
      href={SHINGLE_CALC_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded px-6 py-3 font-bold bg-primary text-white hover:bg-dark-900 transition-colors"
    >
      Rechner öffnen
    </a>
  </div>

  <p class="mt-3 text-xs text-gray-500">
    Richtwert-Rechner. Für ein belastbares Angebot: Kontakt aufnehmen.
  </p>
  </div>

  </ContentSection>

  <!-- SECTION 3 -->
  <ContentSection
    title="Sanierung im Bestand"
    image={imgLs03}
    alt="Sanierung eines Holzschindeldachs"
  >
    <p>
      Viele Schindeldächer wurden in Etappen repariert und sind heute
      uneinheitlich. Wir beurteilen den Bestand, entfernen schadhaftes
      Material und erneuern in abgestimmten Abschnitten – auch an
      schwer zugänglichen Kirchtürmen.
    </p>
    <p class="mt-4">
      Bei der Bestandsaufnahme achten wir auf Moos und Flechten, lange feucht
      bleibende Bereiche, gebrochene oder morsche Schindeln sowie Laub- und
      Nadelablagerungen. Auch ältere Hagelschäden können eine Rolle spielen:
      Hagel kann Holzfasern beschädigen, obwohl zunächst wenig zu sehen ist.
      Verstärkte Feuchteaufnahme kann in den folgenden Jahren zum Materialabbau
      und später zum Ausbrechen der Schindeln führen.
    </p>
    <p class="mt-4">
      Wir prüfen auch den Aufbau: Eine ungeeignete Vollschalung, direkte Montage
      auf Pappe oder Unterspannbahn sowie zu geringe oder fehlende Hinterlüftung
      und fehlende Firstentlüftung können die Trocknung beeinträchtigen.
      Besonders bei beheizten Gebäuden sind mögliche Kondensatprobleme zu beachten.
      Entscheidend ist die Beurteilung der gesamten Konstruktion vor Ort.
    </p>
    <p class="mt-4">
      Auf Wunsch dokumentieren wir den Zustand vor und nach der Sanierung
      fotografisch oder mittels Digitalem Zwilling.
    </p>
  </ContentSection>

  <ContentSection
    title="Teilreparatur oder Neueindeckung?"
    image={imgSchrunsReparatur}
    alt="Geöffnete Schindeldeckung mit sichtbarer Unterkonstruktion und neuen Holzschindeln"
    reverse={true}
  >
    <p>
      Als grobe Orientierung aus unserer Praxis gilt: Sind noch etwa 75 % der vorhandenen
      Deckung technisch intakt, kann eine Teilreparatur sinnvoll sein. Nähert sich der
      Reparaturaufwand jedoch ungefähr 50 % der Kosten einer Neueindeckung, sollte auch
      eine vollständige Erneuerung wirtschaftlich geprüft werden.
    </p>
    <p class="mt-4">
      Diese Werte sind keine festen Entscheidungsgrenzen, sondern Erfahrungswerte aus
      unserer Arbeit. Gerade bei älteren Dächern kommt es darauf an, welche Restnutzungsdauer
      von der verbleibenden Altdeckung noch zu erwarten ist. Auch Zustand, Konstruktion und
      Zugänglichkeit des Daches spielen dabei eine Rolle. Die Prozentwerte allein reichen
      daher für eine Entscheidung nicht aus.
    </p>
  </ContentSection>

  <ContentSection
    title="Praxisbeispiel: Pfarrkirche Schruns, Vorarlberg"
    image={imgSchrunsTurm}
    alt="Kirchturm und Fassade der Pfarrkirche Schruns"
  >
    <p>
      Am Kirchturm der Pfarrkirche Schruns zeigte die bestehende Lärchenschindeldeckung
      in einzelnen Bereichen starken Moos- und Flechtenbewuchs. Dazu kamen gebrochene
      und teilweise morsche Schindeln. Nach unserer Einschätzung waren trotzdem noch
      rund 90 % der Deckung intakt. Eine vollständige Neueindeckung wäre deshalb aus
      unserer Sicht nicht sinnvoll gewesen, und wir entschieden uns für eine gezielte Teilreparatur.
    </p>
    <p class="mt-4">
      Die schadhaften Bereiche wurden geöffnet und mit 40 cm langen Lärchenschindeln
      in Dreifachdeckung erneuert. Die Arbeiten erfolgten mittels Seilzugang.
      Die Bilder aus unserer Projektdokumentation zeigen den Zustand vor der Reparatur,
      den geöffneten Bereich und die anschließend erneuerten Teilflächen.
    </p>
  </ContentSection>

  <div class="container mx-auto px-4 pb-16 md:pb-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <figure>
        <Image src={imgSchrunsMoos} alt="Moos und Flechten auf verwitterten Holzschindeln am Turm"
          width={800} loading="lazy" class="w-full h-auto rounded shadow-lg" />
        <figcaption class="mt-4 text-gray-600">Moos- und Flechtenbewuchs an der bestehenden Deckung.</figcaption>
      </figure>
      <figure>
        <Image src={imgSchrunsBruch} alt="Gebrochene Holzschindeln mit ausgebrochenen Stellen in der Deckung"
          width={800} loading="lazy" class="w-full h-auto rounded shadow-lg" />
        <figcaption class="mt-4 text-gray-600">Gebrochene Schindeln vor der Reparatur.</figcaption>
      </figure>
      <figure>
        <Image src={imgSchrunsNeu} alt="Helle neue Holzschindeln neben dunkler bestehender Schindeldeckung"
          width={800} loading="lazy" class="w-full h-auto rounded shadow-lg" />
        <figcaption class="mt-4 text-gray-600">Erneuerte Teilfläche neben der erhaltenen Altdeckung.</figcaption>
      </figure>
    </div>
  </div>

  <!-- CTA-BLOCK: identischer Stil wie bei Eindeckungen -->
  <section class="bg-primary text-white py-16 text-center">
    <div class="container mx-auto px-4">
      <h3 class="text-2xl font-bold mb-4">
        Projekt mit Lärchenschindeln geplant?
      </h3>
      <p class="mb-8 opacity-90">
        Wir unterstützen bei Bestandsaufnahme, Reparatur und Neueindeckung mit Lärchenschindeln –
        auch an schwer zugänglichen Dächern und Kirchtürmen.
      </p>
      <a
        href="/kontakt/"
        class="bg-white text-primary px-8 py-3 font-bold rounded hover:bg-dark-900 hover:text-white transition-colors"
      >
        Kontakt aufnehmen
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
