---
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

import heroImage from "../assets/arbeiten-mit-blei/arbeiten-mit-blei04.webp";
import imgBleiDetail1 from "../assets/arbeiten-mit-blei/arbeiten-mit-blei01.webp";
import imgBleiDetail2 from "../assets/arbeiten-mit-blei/arbeiten-mit-blei02.webp";
---

<Layout
  title="Walzblei & Bleiarbeiten am Dach: Anschlüsse, Abdeckungen | Turmdecker"
  description="Walzblei/Kirchenblei im Bestand & Denkmalschutz: Kaminverwahrung, Gesims- und Mauerabdeckungen, Verbleiungen. Tirol – österreichweit."
>
  <Header slot="header" />

  <Hero
    images={[heroImage]}
    heightClass="h-[55vh]"
    contentClass="pt-24 md:pt-28"
    overlayClass="bg-black/35"
    bgOpacityClass=""
    storageKey="tdHero:arbeiten-mit-blei"
  >
    <p class="uppercase tracking-[0.2em] text-white/70 text-xs md:text-sm">
      Walzblei · Denkmalschutz · Dach &amp; Fassade
    </p>

    <h1 class="text-4xl md:text-6xl font-bold mt-4">
      ARBEITEN MIT <span class="text-primary">BLEI.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-white/85 text-lg leading-relaxed">
      Walzblei (Dachdeckerblei) für Anschlüsse, Abdeckungen und Verbleiungen – direkt am Objekt geformt,
      sauber geführt und auf Dauer dicht. Tirol – bei passenden Projekten österreichweit und darüber hinaus.
    </p>
  </Hero>

  <section class="py-14 md:py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-bold text-dark-900 mb-6">Walzblei im Bestand & Denkmalschutz</h2>

      <p class="text-gray-700 leading-relaxed">
        Bei Blei zählt nicht die Theorie, sondern die Ausführung: Stoßführung, Bewegungsfreiheit und eine saubere Einbindung
        in Deckung und Mauerwerk. Genau dort spielt Walzblei seine Stärken aus – kaltformbar, witterungsstabil und ideal,
        wenn Details kompliziert sind oder die Optik historisch bleiben muss.
      </p>

      <ul class="mt-8 space-y-3 text-gray-700">
        <li>• Gesims- und Mauerabdeckungen, Attiken, exponierte Mauerabschlüsse</li>
        <li>• Verbleiungen an historischen Details (Turm, Ornament, Sonderformen)</li>
        <li>• Reparaturen und Instandsetzung im Bestand (Denkmalschutz-tauglich)</li>
        <li>• Qualitätsplus: <strong>Blei in Blei schweißen</strong> – homogene Nähte, optisch ruhig und materialgerecht</li>
        <li>• Kaminverwahrung und Wandanschlüsse (regensicher, wartungsarm)</li>
      </ul>

      <div class="mt-10 p-6 rounded-md bg-gray-50 border border-gray-200">
        <h3 class="font-bold text-dark-900 mb-2">Sicherheit &amp; Umgang</h3>
        <p class="text-gray-700 leading-relaxed">
		Bleiarbeiten führen wir kontrolliert und materialgerecht aus – mit sauberer Baustellenführung und fachgerechter Entsorgung von Restmaterial.
		Anwendungen im Trinkwasserbereich übernehmen wir nicht.
	  </p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-gray-50 border-t border-gray-200">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-bold text-dark-900 mb-6">Ablauf</h2>
      <ol class="space-y-3 text-gray-700">
        <li>1) Kurzer Bestand-Check (Detail, Untergrund, Wasserweg)</li>
        <li>2) Konzept: Anschlussführung, Befestigung, Falz- oder Schweißlösung</li>
        <li>3) Ausführung + Dichtheits- / Funktionskontrolle</li>
        <li>4) Dokumentation (Fotos + kurze Maßnahmenbeschreibung)</li>
      </ol>
    </div>
  </section>

  <section class="py-12 md:py-14 bg-gray-50 border-y border-gray-200">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <figure class="relative overflow-hidden rounded-sm shadow-sm bg-black/5">
          <Image
            src={imgBleiDetail1}
            alt="Verbleiung an einem historischen Gesims"
            width={900}
            height={675}
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="relative overflow-hidden rounded-sm shadow-sm bg-black/5">
          <Image
            src={imgBleiDetail2}
            alt="Detail einer Bleiabdeckung an einem Turm"
            width={900}
            height={675}
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <p class="mt-4 text-xs text-gray-500">
        Beispiele aus der Praxis: Walzblei/Kirchenblei mit sauberer Stoßführung, kontrollierten Bewegungsfugen
        und – wo sinnvoll – Blei-in-Blei-Schweißnähten für eine ruhige, homogene Oberfläche.
      </p>
    </div>
  </section>

  <section class="py-20 bg-primary text-white text-center">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold mb-8">Bleiarbeit im Bestand?</h2>
      <a
        href="/kontakt/"
        class="inline-block bg-white text-primary hover:bg-dark-900 hover:text-white px-10 py-4 font-bold rounded transition-all shadow-xl"
      >
        Kontakt aufnehmen
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>